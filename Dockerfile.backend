# syntax=docker/dockerfile:1

# ---------- build ----------
FROM node:22-alpine AS build
WORKDIR /build

COPY package.json package-lock.json ./
COPY shared/package.json ./shared/
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/

# Install scripts must run: esbuild places its platform binary from one.
# HUSKY=0 skips the root `prepare` hook, which needs a .git dir.
ENV HUSKY=0
RUN npm ci

COPY shared ./shared
COPY backend ./backend

# `prisma.config.ts` validates DATABASE_URL, but no database is reachable during
# the build. The real value comes from the Railway environment at runtime.
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build"

# `build:api` runs `prisma generate && nest build`. The generator emits
# TypeScript into backend/generated, which tsc then compiles alongside src/,
# producing dist/src/** and dist/generated/**.
RUN npm run build:shared
RUN npm run build:api

# ---------- runtime ----------
FROM node:22-alpine AS runtime
WORKDIR /app

COPY --from=caddy:2-alpine /usr/bin/caddy /usr/bin/caddy

ENV NODE_ENV=production
# backend/tsconfig.json sets baseUrl, so the emitted JS keeps bare specifiers
# such as `src/shared/config/env` and `generated/prisma/client`. NODE_PATH
# points Node at the compiled tree so those resolve.
ENV NODE_PATH=/app/dist
# Caddy owns $PORT (the port Railway exposes); Nest listens behind it.
ENV NEST_PORT=3001
ENV HOST=127.0.0.1

# Dependencies are hoisted to the workspace root. Dev dependencies are kept on
# purpose: the `prisma` CLI used by the pre-deploy migration step is one.
COPY --from=build /build/node_modules ./node_modules
COPY --from=build /build/backend/dist ./dist
COPY --from=build /build/backend/prisma ./prisma
COPY --from=build /build/backend/prisma.config.ts ./prisma.config.ts
COPY --from=build /build/backend/package.json ./package.json

COPY backend/Caddyfile ./Caddyfile
COPY backend/docker-entrypoint.sh ./docker-entrypoint.sh
RUN chmod +x ./docker-entrypoint.sh

# Mount point for the Railway volume that persists uploaded images.
RUN mkdir -p /app/uploads

EXPOSE 3000

# CMD, not ENTRYPOINT: Railway replaces the command for the pre-deploy
# migration step, and an ENTRYPOINT would run the app instead.
CMD ["/app/docker-entrypoint.sh"]
