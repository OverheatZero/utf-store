# syntax=docker/dockerfile:1

# ---------- build ----------
FROM node:22-alpine AS build
WORKDIR /build

# Manifests first so `npm ci` is cached independently of the sources.
COPY package.json package-lock.json ./
COPY shared/package.json ./shared/
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/

# Install scripts must run: esbuild places its platform binary from one.
# HUSKY=0 skips the root `prepare` hook, which needs a .git dir.
ENV HUSKY=0
RUN npm ci

COPY shared ./shared
COPY frontend ./frontend

# Baked into the bundle at build time. Defaults to the relative path served by
# the Caddy reverse proxy in front of this same container.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build:shared
RUN npm run build:front

# ---------- runtime ----------
FROM caddy:2-alpine AS runtime
WORKDIR /app

COPY --from=build /build/frontend/dist ./dist
COPY frontend/Caddyfile ./Caddyfile

EXPOSE 3000

CMD ["caddy", "run", "--config", "/app/Caddyfile", "--adapter", "caddyfile"]
